# ---- API Gateway ----
PORT=8080
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ---- MySQL (Aiven cloud) ----
MYSQL_HOST=mysql-c65cf31-lua-ae9f.f.aivencloud.com
MYSQL_PORT=18287
MYSQL_USER=avnadmin
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DATABASE=defaultdb
MYSQL_SSL=true

# ---- RabbitMQ (CloudAMQP) ----
RABBITMQ_URL=amqps://USER:PASSWORD@HOST/VHOST
RABBITMQ_EXCHANGE=pokeshop.events

# ---- Firebase Admin (PLACEHOLDER - fill in later) ----
# Either paste the whole service-account JSON on one line:
FIREBASE_SERVICE_ACCOUNT_JSON=
# ...or point at a mounted file:
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=local-ai-6b086

# Dev escape hatch: when true and Firebase Admin is not configured,
# the gateway accepts "Bearer dev:<uid>:<role>" tokens. NEVER enable in production.
AUTH_DEV_BYPASS=true

# Comma-separated emails auto-promoted to admin on first login
ADMIN_EMAILS=admin@sporthub.dev
